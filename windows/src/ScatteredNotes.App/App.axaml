<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ic="using:FluentIcons.Avalonia"
             x:Class="ScatteredNotes.App.App"
             Name="Scattered Notes"
             RequestedThemeVariant="Default">
  <Application.Resources>
    <ResourceDictionary>
      <!-- WCAG AA colours, the same values as the Mac app's AccessibleTheme -->
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="WcagGreen" Color="#166534" />
          <SolidColorBrush x:Key="WcagOrange" Color="#C2410C" />
          <SolidColorBrush x:Key="WcagPurple" Color="#6B21A8" />
          <SolidColorBrush x:Key="WcagBlue" Color="#1D4ED8" />
          <SolidColorBrush x:Key="WcagSecondaryText" Color="#475569" />
          <SolidColorBrush x:Key="WcagPlaceholderText" Color="#64748B" />
          <SolidColorBrush x:Key="WcagBorder" Color="#94A3B8" />
          <SolidColorBrush x:Key="WcagSelection" Color="#1D4ED8" />
          <SolidColorBrush x:Key="WcagBadgeBackground" Color="#EBEBEB" />
          <SolidColorBrush x:Key="CardBackground" Color="#FFFFFF" />
          <SolidColorBrush x:Key="CardBorder" Color="#E2E8F0" />
          <SolidColorBrush x:Key="PaneBackground" Color="#F3F4F6" />
          <SolidColorBrush x:Key="HoverBackground" Color="#0F000000" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="WcagGreen" Color="#4ADE80" />
          <SolidColorBrush x:Key="WcagOrange" Color="#FB923C" />
          <SolidColorBrush x:Key="WcagPurple" Color="#C084FC" />
          <SolidColorBrush x:Key="WcagBlue" Color="#60A5FA" />
          <SolidColorBrush x:Key="WcagSecondaryText" Color="#CBD5E1" />
          <SolidColorBrush x:Key="WcagPlaceholderText" Color="#94A3B8" />
          <SolidColorBrush x:Key="WcagBorder" Color="#64748B" />
          <SolidColorBrush x:Key="WcagSelection" Color="#1E40AF" />
          <SolidColorBrush x:Key="WcagBadgeBackground" Color="#383838" />
          <SolidColorBrush x:Key="CardBackground" Color="#272727" />
          <SolidColorBrush x:Key="CardBorder" Color="#3A3A3A" />
          <SolidColorBrush x:Key="PaneBackground" Color="#1C1C1C" />
          <SolidColorBrush x:Key="HoverBackground" Color="#18FFFFFF" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />

    <!-- Colour classes. Styles, not local values, so a selected row can turn its text white -->
    <Style Selector="TextBlock.WcagGreen"><Setter Property="Foreground" Value="{DynamicResource WcagGreen}" /></Style>
    <Style Selector="ic|SymbolIcon.WcagGreen"><Setter Property="Foreground" Value="{DynamicResource WcagGreen}" /></Style>
    <Style Selector="TextBlock.WcagOrange"><Setter Property="Foreground" Value="{DynamicResource WcagOrange}" /></Style>
    <Style Selector="ic|SymbolIcon.WcagOrange"><Setter Property="Foreground" Value="{DynamicResource WcagOrange}" /></Style>
    <Style Selector="TextBlock.WcagPurple"><Setter Property="Foreground" Value="{DynamicResource WcagPurple}" /></Style>
    <Style Selector="ic|SymbolIcon.WcagPurple"><Setter Property="Foreground" Value="{DynamicResource WcagPurple}" /></Style>
    <Style Selector="TextBlock.WcagBlue"><Setter Property="Foreground" Value="{DynamicResource WcagBlue}" /></Style>
    <Style Selector="ic|SymbolIcon.WcagBlue"><Setter Property="Foreground" Value="{DynamicResource WcagBlue}" /></Style>
    <Style Selector="TextBlock.WcagSecondaryText"><Setter Property="Foreground" Value="{DynamicResource WcagSecondaryText}" /></Style>
    <Style Selector="ic|SymbolIcon.WcagSecondaryText"><Setter Property="Foreground" Value="{DynamicResource WcagSecondaryText}" /></Style>
    <Style Selector="TextBlock.WcagPlaceholderText"><Setter Property="Foreground" Value="{DynamicResource WcagPlaceholderText}" /></Style>
    <Style Selector="ic|SymbolIcon.WcagPlaceholderText"><Setter Property="Foreground" Value="{DynamicResource WcagPlaceholderText}" /></Style>
    <Style Selector="Border.badge"><Setter Property="Background" Value="{DynamicResource WcagBadgeBackground}" /></Style>

    <Style Selector="TextBlock.secondary">
      <Setter Property="Foreground" Value="{DynamicResource WcagSecondaryText}" />
    </Style>
    <Style Selector="TextBlock.caption">
      <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- Plain icon buttons, like the Mac toolbar's borderless buttons -->
    <Style Selector="Button.icon">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="6" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Button.link">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="2" />
      <Setter Property="Foreground" Value="{DynamicResource WcagBlue}" />
    </Style>

    <!-- Lists draw their own WCAG compliant selection, whatever the accent colour is -->
    <Style Selector="ListBox.wcag ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="6,1" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="ListBox.wcag ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource WcagSelection}" />
    </Style>
    <Style Selector="ListBox.wcag ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource WcagSelection}" />
    </Style>
    <Style Selector="ListBox.wcag ListBoxItem:selected:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource WcagSelection}" />
    </Style>
    <Style Selector="ListBox.wcag ListBoxItem:selected:focus /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource WcagSelection}" />
    </Style>
    <Style Selector="ListBox.wcag ListBoxItem:selected TextBlock">
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="ListBox.wcag ListBoxItem:selected Border.badge">
      <Setter Property="Background" Value="#38000000" />
    </Style>
    <Style Selector="ListBox.wcag ListBoxItem:selected ic|SymbolIcon">
      <Setter Property="Foreground" Value="White" />
    </Style>
  </Application.Styles>
</Application>
